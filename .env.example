TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
SITE_ACCESS_PASSWORD=""
CATALOG_CACHE_MS=""
# Optional local dev fallback. If empty, dev also tries deploy/input/turso/etso.sqlite.
LOCAL_CATALOG_SQLITE_PATH=""

# Correction proposal email alerts. Email delivery uses RESEND_API_KEY when configured.
FEEDBACK_RECIPIENT_EMAIL=""
RESEND_API_KEY=""
FEEDBACK_FROM_EMAIL=""

# R2 public bucket: etso-public-assets
# Public r2.dev URL or custom domain for the bucket root.
PUBLIC_R2_PUBLIC_ASSETS_BASE_URL=""
# Optional override. Leave empty to use PUBLIC_R2_PUBLIC_ASSETS_BASE_URL/resumenes.
PUBLIC_SUMMARIES_BASE_URL=""
# Optional override for the frequency-only index. Production defaults to versioned releases on public R2.
PUBLIC_TEXORO_FREQUENCY_INDEX_BASE_URL=""
# Emergency fallback to the private server search.
TEXORO_DISABLE_FREQUENCY_WORKER=""

# Optional dedicated private bucket and credentials. Otherwise use etso-textos/texoro-search with R2_TEXT_*.
R2_TEXORO_INDEX_ACCOUNT_ID=""
R2_TEXORO_INDEX_ACCESS_KEY_ID=""
R2_TEXORO_INDEX_SECRET_ACCESS_KEY=""
R2_TEXORO_INDEX_BUCKET=""
R2_TEXORO_INDEX_PREFIX=""
# Optional S3 endpoint for a jurisdictional bucket.
R2_TEXORO_INDEX_ENDPOINT_URL=""

# R2 private bucket: etso-textos
# Use an R2 token scoped to read this bucket.
R2_TEXT_ACCOUNT_ID=""
R2_TEXT_ACCESS_KEY_ID=""
R2_TEXT_SECRET_ACCESS_KEY=""
R2_TEXT_BUCKET="etso-textos"
R2_TEXT_PREFIX=""
