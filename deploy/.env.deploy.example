# Cloudflare R2
R2_ACCOUNT_ID="tu_account_id"
# Opcional para buckets con jurisdicción específica, por ejemplo la europea:
# R2_ENDPOINT_URL="https://tu_account_id.eu.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="tu_access_key_id"
R2_SECRET_ACCESS_KEY="tu_secret_access_key"

# Índice TEXORO en el bucket privado de textos, bajo un prefijo reservado.
R2_TEXORO_INDEX_BUCKET="etso-textos"
R2_TEXORO_INDEX_PREFIX="texoro-search"
# Opcional: credenciales de publicación separadas de las de los demás destinos.
# R2_TEXORO_INDEX_PUBLISH_ACCESS_KEY_ID="tu_access_key_id_de_publicacion"
# R2_TEXORO_INDEX_PUBLISH_SECRET_ACCESS_KEY="tu_secret_access_key_de_publicacion"

# Alternativa si prefieres un perfil local de AWS CLI en vez de keys en este archivo:
# AWS_PROFILE="r2-etso-deploy"

# Turso
TURSO_DB_NAME="etso-prod"
# Por defecto deploy-all sincroniza Turso con un parche incremental.
# Usar "replace" solo como emergencia para reconstruir la base completa.
TURSO_SYNC_MODE="incremental"
# Windows only, when Turso CLI is installed inside WSL.
TURSO_WSL_DISTRO="Ubuntu"

# Rutas temporales dentro de deploy/input
SQLITE_LOCAL_PATH="deploy/input/turso/etso.sqlite"

# Indice de busqueda generado durante deploy-all
SEARCH_INDEX_INPUT_PATH="deploy/input/private-assets/texts"
SEARCH_INDEX_OUTPUT_PATH="deploy/input/private-assets/search"
SEARCH_INDEX_COMPACT="true"
SEARCH_INDEX_NODE_MAX_OLD_SPACE_SIZE="8192"

# Indice de busqueda de resumenes generado durante deploy-all
SUMMARY_INDEX_SQLITE_PATH="deploy/input/turso/etso.sqlite"
SUMMARY_INDEX_INPUT_PATH="deploy/input/public-assets/resumenes"
SUMMARY_INDEX_OUTPUT_PATH="deploy/input/public-assets/resumenes/search-index.json"
SUMMARY_INDEX_COMPACT="true"

# Opcional
# Si esta variable esta vacia, deploy-all falla por defecto para evitar
# terminar sin redeployar Vercel. Usa REQUIRE_DEPLOY_HOOK="false" solo si
# vas a hacer el redeploy manualmente.
DEPLOY_HOOK_URL=""
REQUIRE_DEPLOY_HOOK="true"
